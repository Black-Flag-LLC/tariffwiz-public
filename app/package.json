{
  "name": "tariffwiz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.scripts.json",
    "audit:headings": "tsx scripts/audit_headings.ts --max 150",
    "check": "npm run lint && npm run typecheck && npm test && npm run audit:headings",
    "quote": "tsx scripts/quote.ts",
    "census": "tsx scripts/validate_census.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild": true
  }
}
